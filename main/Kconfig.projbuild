menu "RAMMP HMI"

    config HMI_REMOTE_UI
        bool "Remote UI debug channel (screenshots + input injection)"
        default n
        help
            Opens a TCP server on port 3333 that hands out the current frame as
            raw RGB565 and injects touch, joystick and button input, so the whole
            UI can be walked and captured from scripts/hmi_ui.py instead of by
            someone looking at the panel.

            It cannot drive the chair: injected joystick directions only move
            the UI's focus and never reach the stick values sent to the MCB.
            It CAN press anything on screen -- ACTIVATE DRIVE, the seat and
            actuator jog buttons -- and it has no authentication, so anything on
            the same network can.

            Off by default for that reason. Turn it on in your local sdkconfig
            (which is not in git) while working on the UI, not in
            sdkconfig.defaults -- that one ships.

    config HMI_WIFI_SSID
        string "WiFi network name (SSID)"
        default ""
        help
            The network the HMI joins when Internet Settings is on WiFi (the
            Tab5's ESP32-C6, 2.4 GHz only), until one is joined from that
            screen. Empty, with none joined = no WiFi: the HMI uses Ethernet
            (the W5500) whatever that setting says.

            Set it, and HMI_WIFI_PASSWORD, in your local sdkconfig (not in git),
            never in sdkconfig.defaults. A network behind a login page (a
            captive portal) will not work: nothing on the HMI can log in.

    config HMI_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            WPA2/WPA3 passphrase for HMI_WIFI_SSID. Empty = an open network.

    config HMI_OTA_TEST_URL
        string "Firmware update: one more image to offer, from this URL"
        default ""
        help
            Settings > Firmware update lists the GitHub releases. Set this and
            the list starts with one more entry, "Test image", that installs
            whatever this URL serves -- an http:// one is fine -- so an update
            can be tried before it is published, e.g.

                python -m http.server 8070 --directory build
                http://<this PC>:8070/rammp-hmi-p4.bin

            The same checks apply as to a release, except that there is no
            digest to compare it with. For your local sdkconfig only; empty in
            sdkconfig.defaults, which ships.

    config HMI_BENCH_DA7280_TEST
        bool "Bench: DA7280 haptic driver tests at boot"
        default n
        help
            Runs the DA7280 bring-up probe (CHIP_REV read) and the driver's
            functional test from app_main, before the IO expanders come up:
            15 numbered vibrations ([DA7280 TEST NN/15]) on the LRA, with
            pauses, so boot takes that much longer and the motor buzzes.

            A bench feature (CS-LAY-09): off by default and in
            sdkconfig.defaults, which ships; ci/sdkconfig.bench turns it on for
            the bench variant L0 builds. The self test's DA7280 row does not
            depend on it: that one reads the boot I2C probe.

    # Hidden: CONFIG_HMI_BENCH_DA7280_TEST as 0/1. sdkconfig.h leaves an unset
    # bool undefined, so without this the C++ would need #ifdef to read it; an
    # int is always defined and becomes a constexpr with no preprocessor
    # conditional (CS-TYP-05; the L0 ratchet's if_config count).
    config HMI_BENCH_DA7280_TEST_AS_INT
        int
        default 1 if HMI_BENCH_DA7280_TEST
        default 0

    config HMI_DEBUG_FPS
        bool "Debug: per-second frame-rate report ([FPS])"
        default n
        help
            Measures what LVGL actually renders (RENDER_START to RENDER_READY)
            and logs once a second, at debug level under the "fps" tag:
                [FPS] 59.8 fps | render avg 4.12 ms | max 6.03 ms
            It also loads the Drive screen at boot instead of the boot screen,
            whose logo would otherwise dominate the numbers.

            A debug feature (CS-LAY-09): off by default and never in
            sdkconfig.defaults, which ships. Turn it on in your local sdkconfig.

    config HMI_DEBUG_FPS_STRESS
        bool "Debug: invalidate the whole screen every LVGL cycle"
        depends on HMI_DEBUG_FPS
        default n
        help
            A static SquareLine screen invalidates nothing and renders nothing,
            so HMI_DEBUG_FPS alone measures an idle screen. This forces a full
            redraw every cycle: the sustained worst case.

    # Hidden: the two FPS options as 0/1. sdkconfig.h leaves an unset bool
    # undefined, so without these the C++ would need #ifdef to read them; an
    # int is always defined and becomes a constexpr with no preprocessor
    # conditional (CS-TYP-05; the L0 ratchet's if_config count).
    config HMI_DEBUG_FPS_AS_INT
        int
        default 1 if HMI_DEBUG_FPS
        default 0

    config HMI_DEBUG_FPS_STRESS_AS_INT
        int
        default 1 if HMI_DEBUG_FPS_STRESS
        default 0

    config HMI_DEBUG_HEAP_WATCH
        bool "Debug: watch the internal heaps for a corrupt block (HEAPWATCH)"
        default n
        help
            A static task walks every internal heap each
            HMI_DEBUG_HEAP_WATCH_PERIOD_MS and checks each block lies inside its
            heap; on the first bad one it prints HEAPWATCH lines (time, last
            clean walk, the bad block and the blocks before it) through the ROM
            console and aborts. At 2.5 s and 20 s it maps the blocks between
            HMI_DEBUG_HEAP_WATCH_MAP_LO and _MAP_HI. See main/heap_watch.hpp.

            A debug feature (CS-LAY-09), for the boot heap-corruption hunt: off
            by default and never in sdkconfig.defaults, which ships.

    config HMI_DEBUG_HEAP_WATCH_PERIOD_MS
        int "Debug: heap watch period (ms)"
        range 1 1000
        default 5

    config HMI_DEBUG_HEAP_WATCH_INTEGRITY_EVERY
        int "Debug: also run heap_caps_check_integrity every N walks (0 = never)"
        range 0 1000
        default 0
        help
            With CONFIG_HEAP_POISONING_COMPREHENSIVE this names the overrun
            block. It checks every free byte with interrupts off on its core,
            so keep N such that it runs every 20 ms or more.

    config HMI_DEBUG_HEAP_WATCH_MAP_LO
        hex "Debug: heap watch map, first address"
        default 0x4FF3AFC0

    config HMI_DEBUG_HEAP_WATCH_MAP_HI
        hex "Debug: heap watch map, end address"
        default 0x4FF3B900

    # Hidden: HMI_DEBUG_HEAP_WATCH as 0/1 (CS-TYP-05, as above).
    config HMI_DEBUG_HEAP_WATCH_AS_INT
        int
        default 1 if HMI_DEBUG_HEAP_WATCH
        default 0

endmenu
