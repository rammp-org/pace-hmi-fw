# joystick_cal is safety-relevant (CS-SAF-01: the calibration maps raw stick millivolts to
# motion): functions at most 60 lines (CS-FIL-01).
# Everything else comes from the repo root's .clang-tidy (the fw-standards config).
InheritParentConfig: true
CheckOptions:
  - { key: readability-function-size.LineThreshold, value: 60 }
